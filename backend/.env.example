# Copy to .env and fill in real values – never commit .env

# Firebase project used to verify sign-in tokens. Only the project id is needed
# (this is not a secret). If unset, it is read from FIREBASE_CREDENTIALS_JSON.
FIREBASE_PROJECT_ID=retail-actions
# FIREBASE_CREDENTIALS_JSON=./serviceAccountKey.json

# Where the YOLO weights live (yolov8n.pt, yolov8n-pose.pt). Auto-downloaded on first run.
ARTIFACTS_DIR=./artifacts

# Comma-separated list of frontend origins allowed to connect.
CORS_ORIGINS=http://localhost:3000

# Number of CV worker threads.
CV_WORKERS=2

# Store layout used by the scoring engine (default: lifestyle).
# BAM_STORE_FORMAT=lifestyle
